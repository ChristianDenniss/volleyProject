{
  "name": "@volley/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@volley/media": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@tailwindcss/postcss": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "shadcn": "4.18.0",
    "tailwindcss": "latest",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "scripts": {
    "dev": "bun run db:migrate:local && vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview:upload": "vinext build && wrangler versions upload --config dist/server/wrangler.json",
    "check": "vinext check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --exclude tests/node/reachability.test.ts --exclude tests/node/conformance.test.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply volley-project --local",
    "db:migrate:remote": "wrangler d1 migrations apply volley-project --remote",
    "db:seed:local": "bun run seed:sql && wrangler d1 execute volley-project --local --file tests/fixtures/seed.sql",
    "inventory": "tsx tooling/extract-routes.ts && tsx tooling/extract-endpoints.ts && tsx tooling/extract-data-deps.ts",
    "seed:sql": "tsx tooling/emit-seed-sql.ts",
    "t3:prepare": "bun run seed:sql && wrangler d1 migrations apply volley-project --local && wrangler d1 execute volley-project --local --file tests/fixtures/seed.sql && tsx tooling/seed-sessions.ts",
    "test:t3": "vitest run --project node tests/node/reachability.test.ts",
    "test:s2-import": "tsx tooling/test-s2-import.ts",
    "prune:versions": "tsx tooling/prune-worker-versions.ts",
    "prune:versions:dry": "tsx tooling/prune-worker-versions.ts --dry-run"
  }
}
