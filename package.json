{
  "name": "volley-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "better-sqlite3",
    "@biomejs/biome",
    "sharp"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  },
  "scripts": {
    "dev": "bun --filter @volley/web dev",
    "build": "bun --filter @volley/web build",
    "deploy": "bun --filter @volley/web deploy",
    "start": "bun --filter @volley/web start",
    "preview:upload": "bun --filter @volley/web preview:upload",
    "test": "bun --filter @volley/web test",
    "test:ci": "bun --filter @volley/web test:ci",
    "test:watch": "bun --filter @volley/web test:watch",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "db:generate": "bun --filter @volley/web db:generate",
    "db:migrate:local": "bun --filter @volley/web db:migrate:local",
    "db:migrate:remote": "bun --filter @volley/web db:migrate:remote",
    "db:seed:local": "bun --filter @volley/web db:seed:local",
    "images:deploy": "bun --filter @volley/images deploy",
    "images:dev": "bun --filter @volley/images dev",
    "images:typecheck": "bun --filter @volley/images typecheck",
    "prune:versions": "bun --filter @volley/web prune:versions",
    "prune:versions:dry": "bun --filter @volley/web prune:versions:dry"
  }
}
