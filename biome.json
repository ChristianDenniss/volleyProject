{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.next",
      "!.vinext",
      "!.wrangler",
      "!drizzle",
      "!node_modules",
      "!.claude",
      "!components/ui",
      "!**/*.d.ts",
      "!**/*.css",
      "!tsconfig.tsbuildinfo"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "noLabelWithoutControl": "warn",
        "useButtonType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn",
        "noDoubleEquals": "error",
        "noDocumentCookie": "off",
        "useIterableCallbackReturn": "error",
        "useAwait": "off",
        "noShadow": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error",
        "noUnsafeOptionalChaining": "error",
        "useExhaustiveDependencies": "error",
        "useJsxKeyInIterable": "error",
        "useHookAtTopLevel": "error"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noBannedTypes": "error",
        "useOptionalChain": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "off",
        "useImportType": "off",
        "noProcessEnv": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tooling/**", "tests/node/**", "*.config.ts", "*.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
